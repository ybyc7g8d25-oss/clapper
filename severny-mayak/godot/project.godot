; «Пиксель» (бывш. «Северный маяк») (Godot 4.4). Игра рисуется в 480x270 и растягивается на весь экран (см. scripts/main.gd).
config_version=5

[application]

config/name="Пиксель"
config/version="3.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.0706, 0.0667, 0.0824, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="Pixel"

[autoload]

G="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0706, 0.0667, 0.0824, 1)
