; Северный маяк — проект Godot 4.4
config_version=5

[application]

config/name="Северный маяк"
config/description="Психологический хоррор на одном рабочем столе"
config/version="1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://art/pix_0.png"
boot_splash/bg_color=Color(0.0196, 0.0157, 0.0392, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="SevernyMayak"

[autoload]

G="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=3
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0196, 0.0157, 0.0392, 1)
